#!/bin/bash
#PBS -N enum-it-direct
#PBS -q gpu-bigmem
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "Paper-like direct-label instruction steering job started: $(date)"
echo "Host: $(hostname)"
echo "Workdir: $PBS_O_WORKDIR"
echo "Job id: ${PBS_JOBID:-unknown}"

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run first: bash srce/setup_uv_env.sh"
  exit 2
fi

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="$PBS_O_WORKDIR/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

mkdir -p "$HF_HOME" "$TRANSFORMERS_CACHE" "$HF_DATASETS_CACHE" outputs
source srce/load_hf_token.sh

export MODEL_CHOICE="${MODEL_CHOICE:-mistral_7b_it}"
export DRIVE_PATH="$PBS_O_WORKDIR/outputs"
export ARTIFACT_SUBDIR="${ARTIFACT_SUBDIR:-phase2_activation_steering_enumerability_it_paperlike_directlabel}"
export PHASE1_CSV="$PBS_O_WORKDIR/outputs/df_webq_balanced.csv"

export PROMPT_VARIANT="${PROMPT_VARIANT:-zero_shot_direct_label}"
export CHAT_ASSISTANT_PREFILL=0
export POSITIONS=auto
export GENERATION_HOOK_MODE=prefill_only

export MAX_TRAIN_PER_CLASS="${MAX_TRAIN_PER_CLASS:-1000}"
export MAX_VAL_PER_CLASS="${MAX_VAL_PER_CLASS:-300}"
export MAX_TEST_PER_CLASS="${MAX_TEST_PER_CLASS:-300}"
export MAX_MANUAL_QUESTIONS="${MAX_MANUAL_QUESTIONS:-10}"
export WEBQ_EVAL_PER_CLASS="${WEBQ_EVAL_PER_CLASS:-50}"
export MAX_OOD_QUESTIONS="${MAX_OOD_QUESTIONS:-12}"

export BATCH_SIZE_ACTIVATIONS="${BATCH_SIZE_ACTIVATIONS:-4}"
export BATCH_SIZE_SCORING="${BATCH_SIZE_SCORING:-4}"
export BATCH_SIZE_GENERATION="${BATCH_SIZE_GENERATION:-2}"
export MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-64}"
export MODEL_QUANTIZATION="${MODEL_QUANTIZATION:-4bit}"
export TORCH_DTYPE="${TORCH_DTYPE:-float16}"
export SANITY_ALPHA_FOR_DELTA="${SANITY_ALPHA_FOR_DELTA:-4.0}"

export ALPHAS="${ALPHAS:--6.0,-4.0,-2.0,-1.0,0.0,1.0,2.0,4.0,6.0}"

echo "Prompt variant: $PROMPT_VARIANT"
echo "Assistant prefill: $CHAT_ASSISTANT_PREFILL"
echo "Positions: $POSITIONS"
echo "Generation hook mode: $GENERATION_HOOK_MODE"

.venv/bin/python phase2_activation_steering_enumerability.py

echo "Running paper-like direct-label sanity check: $(date)"
.venv/bin/python sanity_check_paperlike_instruction_steering.py

echo "Paper-like direct-label instruction steering job finished: $(date)"
