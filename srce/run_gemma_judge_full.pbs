#!/bin/bash
#PBS -N gemma-judge-full
#PBS -q gpu-bigmem
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "Judge full run started: $(date)"
echo "Host: $(hostname)"
echo "Workdir: $PBS_O_WORKDIR"
echo "Job id: ${PBS_JOBID:-unknown}"

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run first: bash srce/setup_uv_env.sh"
  exit 2
fi

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="$PBS_O_WORKDIR/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

export JUDGE_MODEL="${JUDGE_MODEL:-google/gemma-4-31B-it}"
export RESULTS_DIR="$PBS_O_WORKDIR/outputs/phase2_activation_steering_enumerability/mistral_7b"
export JUDGE_OUTPUT_SUBDIR="gemma_judge"
export JUDGE_BATCH_SIZE=5
export JUDGE_MAX_ROWS=0
export JUDGE_USE_4BIT=1
export JUDGE_TORCH_DTYPE=float16

.venv/bin/python judge_answer_counts_gemma.py

echo "Judge full run finished: $(date)"
