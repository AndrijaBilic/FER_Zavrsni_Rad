#!/bin/bash
#PBS -N gemma-judge-test
#PBS -q gpu-bigmem
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "Judge test started: $(date)"
echo "Host: $(hostname)"
echo "Workdir: $PBS_O_WORKDIR"
echo "Job id: ${PBS_JOBID:-unknown}"

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run first: bash srce/setup_uv_env.sh"
  exit 2
fi

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="$PBS_O_WORKDIR/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

export MODEL_CHOICE="${MODEL_CHOICE:-mistral}"
export DRIVE_PATH="$PBS_O_WORKDIR/outputs"
export ARTIFACT_SUBDIR="phase2_activation_steering_enumerability"
export JUDGE_MODEL="${JUDGE_MODEL:-google/gemma-4-31B-it}"
export JUDGE_OUTPUT_SUBDIR="gemma_judge_test"
export JUDGE_BATCH_SIZE=3
export JUDGE_MAX_ROWS=12
export JUDGE_QUANTIZATION=int8
export JUDGE_TORCH_DTYPE=float16

.venv/bin/python judge_answer_counts_gemma.py

echo "Judge test finished: $(date)"
