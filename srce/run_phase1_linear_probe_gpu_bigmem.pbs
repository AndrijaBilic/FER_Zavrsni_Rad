#!/bin/bash
#PBS -N phase1-probe
#PBS -q gpu-bigmem
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "Phase 1 linear probe started: $(date)"
echo "Host: $(hostname)"
echo "Workdir: $PBS_O_WORKDIR"
echo "Job id: ${PBS_JOBID:-unknown}"

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run first: bash srce/setup_uv_env.sh"
  exit 2
fi

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="$PBS_O_WORKDIR/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

mkdir -p "$HF_HOME" "$TRANSFORMERS_CACHE" "$HF_DATASETS_CACHE" outputs
source srce/load_hf_token.sh

export MODEL_CHOICE="${MODEL_CHOICE:-mistral}"
export DRIVE_PATH="$PBS_O_WORKDIR/outputs"
export ARTIFACT_SUBDIR="${ARTIFACT_SUBDIR:-phase1_linear_probing_enumerability}"
export PHASE1_CSV="$PBS_O_WORKDIR/outputs/df_webq_balanced.csv"

export BATCH_SIZE="${BATCH_SIZE:-2}"
export N_PERMUTATIONS="${N_PERMUTATIONS:-10}"
export MODEL_QUANTIZATION="${MODEL_QUANTIZATION:-4bit}"
export TORCH_DTYPE="${TORCH_DTYPE:-float16}"
export SAVE_ACTIVATIONS="${SAVE_ACTIVATIONS:-0}"

.venv/bin/python phase1_linear_probing_enumerability.py

echo "Phase 1 linear probe finished: $(date)"
