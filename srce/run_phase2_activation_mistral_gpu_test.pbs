#!/bin/bash
#PBS -N enum-mistral-test
#PBS -q gpu-test
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Workdir: $PBS_O_WORKDIR"
echo "Job id: ${PBS_JOBID:-unknown}"

if [ ! -x .venv/bin/python ]; then
  echo "Missing .venv. Run first: bash srce/setup_uv_env.sh"
  exit 2
fi

export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME="$PBS_O_WORKDIR/.cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

mkdir -p "$HF_HOME" "$TRANSFORMERS_CACHE" "$HF_DATASETS_CACHE" outputs
source srce/load_hf_token.sh

# Phase-2 activation-steering experiment settings. Override at submission with:
#   qsub -v MODEL_CHOICE=llama31_8b_it srce/run_phase2_activation_mistral_gpu_test.pbs
export MODEL_CHOICE="${MODEL_CHOICE:-mistral}"
export DRIVE_PATH="$PBS_O_WORKDIR/outputs"
export ARTIFACT_SUBDIR="${ARTIFACT_SUBDIR:-phase2_activation_steering_enumerability}"
export PHASE1_CSV="$PBS_O_WORKDIR/outputs/df_webq_balanced.csv"

# Keep this test queue run moderate. It should finish within gpu-test limits
# after the model/dependencies are already cached.
export MAX_TRAIN_PER_CLASS="${MAX_TRAIN_PER_CLASS:-600}"
export MAX_VAL_PER_CLASS="${MAX_VAL_PER_CLASS:-200}"
export MAX_TEST_PER_CLASS="${MAX_TEST_PER_CLASS:-200}"
export MAX_MANUAL_QUESTIONS="${MAX_MANUAL_QUESTIONS:-10}"
export WEBQ_EVAL_PER_CLASS="${WEBQ_EVAL_PER_CLASS:-25}"
export MAX_OOD_QUESTIONS="${MAX_OOD_QUESTIONS:-12}"
export ALPHAS="${ALPHAS:--1.5,-1.0,-0.5,0.0,0.5,1.0,1.5}"

.venv/bin/python phase2_activation_steering_enumerability.py

echo "Job finished: $(date)"
